# Copy to .env.production (or set it in your hosting dashboard) before `npm run build`.
# The public address of the site, with no trailing slash. It is used for canonical URLs,
# Open Graph tags, structured data, sitemap.xml, robots.txt and llms.txt.
# Without it the build still works but skips canonical URLs, sitemap.xml and llms.txt.
VITE_SITE_URL=https://your-domain.example
